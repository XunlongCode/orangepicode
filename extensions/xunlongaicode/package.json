{
	"name": "orangepiaicode",
	"displayName": "OrangePi AI Code",
	"description": "OrangePi ai code assistant.",
	"publisher": "XunlongCode",
	"version": "0.0.6",
	"icon": "assets/icons/orangepi.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.84.0"
	},
	"author": {
		"name": "XunlongCode"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/XunlongCode/orangepiaicode"
	},
	"homepage": "https://github.com/XunlongCode/orangepiaicode",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"roo code",
		"roocode",
		"orangepiaicode"
	],
	"activationEvents": [
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "orangepiaicode-ActivityBar",
					"title": "OrangePi AI Code",
					"icon": "assets/icons/orangepi.svg"
				}
			]
		},
		"views": {
			"orangepiaicode-ActivityBar": [
				{
					"type": "webview",
					"id": "orangepiaicode.SidebarProvider",
					"name": ""
				}
			]
		},
		"commands": [
			{
				"command": "orangepiaicode.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "orangepiaicode.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "orangepiaicode.promptsButtonClicked",
				"title": "Prompts",
				"icon": "$(notebook)"
			},
			{
				"command": "orangepiaicode.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "orangepiaicode.popoutButtonClicked",
				"title": "Open in Editor",
				"icon": "$(link-external)"
			},
			{
				"command": "orangepiaicode.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "orangepiaicode.helpButtonClicked",
				"title": "Documentation",
				"icon": "$(question)"
			},
			{
				"command": "orangepiaicode.openInNewTab",
				"title": "Open In New Tab",
				"category": "OrangePi AI Code"
			},
			{
				"command": "orangepiaicode.explainCode",
				"title": "OrangePi AI Code: Explain Code",
				"category": "OrangePi AI Code"
			},
			{
				"command": "orangepiaicode.fixCode",
				"title": "OrangePi AI Code: Fix Code",
				"category": "OrangePi AI Code"
			},
			{
				"command": "orangepiaicode.improveCode",
				"title": "OrangePi AI Code: Improve Code",
				"category": "OrangePi AI Code"
			},
			{
				"command": "orangepiaicode.addToContext",
				"title": "OrangePi AI Code: Add To Context",
				"category": "OrangePi AI Code"
			},
			{
				"command": "orangepiaicode.terminalAddToContext",
				"title": "OrangePi AI Code: Add Terminal Content to Context",
				"category": "Terminal"
			},
			{
				"command": "orangepiaicode.terminalFixCommand",
				"title": "OrangePi AI Code: Fix This Command",
				"category": "Terminal"
			},
			{
				"command": "orangepiaicode.terminalExplainCommand",
				"title": "OrangePi AI Code: Explain This Command",
				"category": "Terminal"
			},
			{
				"command": "orangepiaicode.terminalFixCommandInCurrentTask",
				"title": "OrangePi AI Code: Fix This Command (Current Task)",
				"category": "Terminal"
			},
			{
				"command": "orangepiaicode.terminalExplainCommandInCurrentTask",
				"title": "OrangePi AI Code: Explain This Command (Current Task)",
				"category": "Terminal"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "orangepiaicode.explainCode",
					"when": "editorHasSelection",
					"group": "OrangePi AI Code@1"
				},
				{
					"command": "orangepiaicode.fixCode",
					"when": "editorHasSelection",
					"group": "OrangePi AI Code@2"
				},
				{
					"command": "orangepiaicode.improveCode",
					"when": "editorHasSelection",
					"group": "OrangePi AI Code@3"
				},
				{
					"command": "orangepiaicode.addToContext",
					"when": "editorHasSelection",
					"group": "OrangePi AI Code@4"
				}
			],
			"terminal/context": [
				{
					"command": "orangepiaicode.terminalAddToContext",
					"group": "OrangePi AI Code@1"
				},
				{
					"command": "orangepiaicode.terminalFixCommand",
					"group": "OrangePi AI Code@2"
				},
				{
					"command": "orangepiaicode.terminalExplainCommand",
					"group": "OrangePi AI Code@3"
				},
				{
					"command": "orangepiaicode.terminalFixCommandInCurrentTask",
					"group": "OrangePi AI Code@5"
				},
				{
					"command": "orangepiaicode.terminalExplainCommandInCurrentTask",
					"group": "OrangePi AI Code@6"
				}
			],
			"view/title": [
				{
					"command": "orangepiaicode.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == orangepiaicode.SidebarProvider"
				},
				{
					"command": "orangepiaicode.promptsButtonClicked",
					"group": "navigation@2",
					"when": "view == orangepiaicode.SidebarProvider"
				},
				{
					"command": "orangepiaicode.mcpButtonClicked",
					"group": "navigation@3",
					"when": "view == orangepiaicode.SidebarProvider"
				},
				{
					"command": "orangepiaicode.historyButtonClicked",
					"group": "navigation@4",
					"when": "view == orangepiaicode.SidebarProvider"
				},
				{
					"command": "orangepiaicode.popoutButtonClicked",
					"group": "navigation@5",
					"when": "view == orangepiaicode.SidebarProvider"
				},
				{
					"command": "orangepiaicode.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == orangepiaicode.SidebarProvider"
				},
				{
					"command": "orangepiaicode.helpButtonClicked",
					"group": "navigation@7",
					"when": "view == orangepiaicode.SidebarProvider"
				}
			]
		},
		"configuration": {
			"title": "OrangePi AI Code",
			"properties": {
				"orangepiaicode.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"npm test",
						"npm install",
						"tsc",
						"git log",
						"git diff",
						"git show"
					],
					"description": "Commands that can be auto-executed when 'Always approve execute operations' is enabled"
				},
				"orangepiaicode.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "The vendor of the language model (e.g. copilot)"
						},
						"family": {
							"type": "string",
							"description": "The family of the language model (e.g. gpt-4)"
						}
					},
					"description": "Settings for VSCode Language Model API"
				},
				"orangepiaicode.enableTabAutocomplete": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable OrangePi AI Code's tab autocomplete feature."
				}
			}
		}
	},
	"scripts": {
		"build": "npm run vsix",
		"build:webview": "cd webview-ui && npm run build",
		"build:esbuild": "node esbuild.js --production",
		"compile": "tsc -p . --outDir out && node esbuild.js",
		"install:all": "npm install npm-run-all && npm run install:_all",
		"install:_all": "npm-run-all -p install-*",
		"install-extension": "npm install",
		"install-webview": "cd webview-ui && npm install",
		"install-e2e": "cd e2e && npm install",
		"install-benchmark": "cd benchmark && npm install",
		"lint": "npm-run-all -p lint:*",
		"lint:extension": "eslint src --ext ts",
		"lint:webview": "cd webview-ui && npm run lint",
		"lint:e2e": "cd e2e && npm run lint",
		"lint:benchmark": "cd benchmark && npm run lint",
		"check-types": "npm-run-all -p check-types:*",
		"check-types:extension": "tsc --noEmit",
		"check-types:webview": "cd webview-ui && npm run check-types",
		"check-types:e2e": "cd e2e && npm run check-types",
		"check-types:benchmark": "cd benchmark && npm run check-types",
		"package": "npm-run-all -p build:webview build:esbuild check-types lint",
		"pretest": "npm run compile",
		"dev": "cd webview-ui && npm run dev",
		"test": "npm-run-all -p test:*",
		"test:extension": "jest",
		"test:webview": "cd webview-ui && npm run test",
		"prepare": "husky",
		"publish:marketplace": "vsce publish && ovsx publish",
		"publish": "npm run build && changeset publish && npm install --package-lock-only",
		"version-packages": "changeset version && npm install --package-lock-only",
		"vscode:prepublish": "npm run package",
		"vsix": "rimraf bin && mkdirp bin && npx vsce package --out bin",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"watch-tests": "tsc -p . -w --outDir out",
		"changeset": "changeset",
		"knip": "knip --include files",
		"clean": "npm-run-all -p clean:*",
		"clean:extension": "rimraf bin dist out",
		"clean:webview": "cd webview-ui && npm run clean",
		"clean:e2e": "cd e2e && npm run clean",
		"clean:benchmark": "cd benchmark && npm run clean",
		"update-contributors": "node scripts/update-contributors.js"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^0.10.2",
		"@anthropic-ai/sdk": "^0.37.0",
		"@anthropic-ai/vertex-sdk": "^0.7.0",
		"@aws-sdk/client-bedrock-runtime": "^3.706.0",
		"@aws-sdk/client-sagemaker-runtime": "^3.758.0",
		"@continuedev/config-yaml": "^1.0.56",
		"@continuedev/fetch": "^1.0.4",
		"@continuedev/llm-info": "^1.0.7",
		"@continuedev/openai-adapters": "^1.0.16",
		"@google-cloud/vertexai": "^1.9.3",
		"@google/generative-ai": "^0.18.0",
		"@huggingface/jinja": "^0.3.3",
		"@mistralai/mistralai": "^1.3.6",
		"@modelcontextprotocol/sdk": "^1.7.0",
		"@mozilla/readability": "^0.6.0",
		"@octokit/rest": "^21.1.1",
		"@types/clone-deep": "^4.0.4",
		"@types/pdf-parse": "^1.1.4",
		"@types/tmp": "^0.2.6",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "^1.95.0",
		"@vscode/codicons": "^0.0.36",
		"adf-to-md": "^1.2.1",
		"async-mutex": "^0.5.0",
		"axios": "^1.7.4",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"comment-json": "^4.2.5",
		"dbinfoz": "^0.14.0",
		"default-shell": "^2.2.0",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"diff-match-patch": "^1.0.5",
		"dotenv": "^16.4.7",
		"fast-deep-equal": "^3.1.3",
		"fastest-levenshtein": "^1.0.16",
		"get-folder-size": "^5.0.0",
		"globby": "^14.0.2",
		"handlebars": "^4.7.8",
		"i18next": "^24.2.2",
		"isbinaryfile": "^5.0.2",
		"jinja-js": "^0.1.8",
		"js-tiktoken": "^1.0.19",
		"jsdom": "^26.0.0",
		"json-schema": "^0.4.0",
		"lodash": "^4.17.21",
		"lru-cache": "^11.0.2",
		"mammoth": "^1.8.0",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-html-markdown": "^1.3.0",
		"node-machine-id": "^1.1.12",
		"onnxruntime-node": "^1.21.0",
		"openai": "^4.78.1",
		"os-name": "^6.0.0",
		"p-limit": "^6.2.0",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"pkce-challenge": "^4.1.0",
		"posthog-node": "^4.7.0",
		"pretty-bytes": "^6.1.1",
		"puppeteer": "^24.4.0",
		"puppeteer-chromium-resolver": "^23.0.0",
		"puppeteer-core": "^23.4.0",
		"quick-lru": "^7.0.0",
		"reconnecting-eventsource": "^1.6.4",
		"replicate": "^1.0.1",
		"request": "^2.88.2",
		"say": "^0.16.0",
		"serialize-error": "^11.0.3",
		"simple-git": "^3.27.0",
		"socket.io-client": "^4.8.1",
		"sound-play": "^1.1.0",
		"sqlite": "^5.1.1",
		"sqlite3": "^5.1.7",
		"string-similarity": "^4.0.4",
		"strip-ansi": "^7.1.0",
		"strip-bom": "^5.0.0",
		"systeminformation": "^5.25.11",
		"tar": "^7.4.3",
		"tmp": "^0.2.3",
		"tree-sitter-wasms": "^0.1.11",
		"turndown": "^7.2.0",
